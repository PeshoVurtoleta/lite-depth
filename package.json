{
  "name": "@zakkster/lite-depth",
  "version": "1.0.0",
  "description": "Zero-GC Canvas2D software-projected 3D (flat-shaded, painter-sorted, pseudo-3D), arena-backed and allocation-free per frame.",
  "type": "module",
  "main": "./Depth.js",
  "module": "./Depth.js",
  "types": "./Depth.d.ts",
  "exports": {
    ".": {
      "node": "./Depth.js",
      "types": "./Depth.d.ts",
      "import": "./Depth.js",
      "default": "./Depth.js"
    }
  },
  "files": [
    "Depth.js",
    "Depth.d.ts",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:gc": "node --expose-gc --test test/*.test.js",
    "bench": "node --expose-gc bench/benchmark.mjs",
    "verify": "npm run test:gc && npm run bench"
  },
  "keywords": [
    "3d",
    "canvas",
    "canvas2d",
    "zdog",
    "painter-algorithm",
    "software-rendering",
    "projection",
    "depth-sort",
    "radix-sort",
    "zero-gc",
    "soa",
    "arena",
    "flat-shading",
    "isometric",
    "pseudo-3d",
    "game",
    "zakkster"
  ],
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-depth.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-depth/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "dependencies": {
    "@zakkster/lite-arena": "^1.0.1",
    "@zakkster/lite-fastbit32": "^1.2.0",
    "@zakkster/lite-aabb": "^1.0.0"
  },
  "peerDependencies": {
    "@zakkster/lite-signal": "^1.4.0",
    "@zakkster/lite-raf": "^1.1.0",
    "@zakkster/lite-clock": "^1.0.0",
    "@zakkster/lite-sprite-cache": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@zakkster/lite-signal": {
      "optional": true
    },
    "@zakkster/lite-raf": {
      "optional": true
    },
    "@zakkster/lite-clock": {
      "optional": true
    },
    "@zakkster/lite-sprite-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": ">=1.1.0",
    "gl-matrix": "^3.4.3",
    "zdog": "^1.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
